---
import BaseLayout from '../layouts/baseLayout.astro';
import { Image } from 'astro:assets';

import poring from '../asserts/poring.png';
const games = [
  { name: "test", type: "RPG", platform: "PC" },
  { name: "test1", type: "SLG", platform: "Mobile" },
  { name: "test2", type: "ACT", platform: "PC / Console" },
];
---
<BaseLayout>
      <section class="section">
        <div class="grid grid-3">
          {games.map((game) => (
            <article class="card">
              <div class="card-cover">
                <img src={poring.src} alt={game.name} />
              </div>
              <div class="card-body">
                <h2 class="card-title">{game.name}</h2>
                <p class="card-desc">這裡可以放遊戲介紹、特色與更新重點摘要。</p>
                <div class="card-meta">
                  <span class="tag">{game.type}</span>
                  <span class="tag success">{game.platform}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
</BaseLayout>
